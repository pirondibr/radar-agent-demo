DEMO_ONLY=0
PORT=8766
PUBLIC_BASE_URL=https://radar-agent-demo.onrender.com

# Live pipeline
OPENROUTER_API_KEY=
SCRAPINGBEE_API_KEY=
DATAFORSEO_USER=
DATAFORSEO_PASS=
SEMRUSH_API_KEY=

# Mercado Pago (Checkout Pro — PIX + cartao)
# Cole Access Token de producao (ou TEST-... para sandbox)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
# 1 = forcar checkout sandbox (credenciais de teste APP_USR- ou TEST-)
MERCADOPAGO_SANDBOX=1
PRO_PRICE_BRL=99

# Dashboard admin (/admin?token=...)
ADMIN_DASHBOARD_TOKEN=troque-este-token
# Opcional: pasta persistente no Render Disk
# RADAR_DATA_DIR=/var/data/radar

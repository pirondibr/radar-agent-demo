DEMO_ONLY=0
PORT=8766
PUBLIC_BASE_URL=https://radar-agent-demo.onrender.com

# Live pipeline
OPENROUTER_API_KEY=
SCRAPINGBEE_API_KEY=
DATAFORSEO_USER=
DATAFORSEO_PASS=
SEMRUSH_API_KEY=

# Mercado Pago (Checkout Pro — PIX + cartao)
# PRODUCAO: use "Credenciais de producao" do painel (Access Token APP_USR-...).
# TESTE: use "Credenciais de teste" + comprador de teste.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
# Com APP_USR o checkout abre em www.mercadopago.com.br (teste ou producao).
# MERCADOPAGO_SANDBOX=0 em producao; =1 so afeta tokens classicos TEST-...
MERCADOPAGO_SANDBOX=0
PUBLIC_BASE_URL=https://agente.radardaconcorrencia.com.br
PRO_PRICE_BRL=99

# Dashboard admin (/admin?token=...)
ADMIN_DASHBOARD_TOKEN=troque-este-token
# Opcional: pasta persistente no Render Disk
# RADAR_DATA_DIR=/var/data/radar

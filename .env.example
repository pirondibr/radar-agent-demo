DEMO_ONLY=0
PORT=8766
PUBLIC_BASE_URL=https://radar-agent-demo.onrender.com

# Live pipeline
OPENROUTER_API_KEY=
SCRAPINGBEE_API_KEY=
DATAFORSEO_USER=
DATAFORSEO_PASS=
SEMRUSH_API_KEY=

# Mercado Pago (Checkout Pro — PIX + cartao)
# Para TESTAR: use "Credenciais de teste" do painel (Access Token APP_USR-...).
# Nao use credenciais de producao se quiser cartao/PIX de teste.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
# Com APP_USR (credenciais de teste atuais) o checkout abre em www.mercadopago.com.br
# (parece producao, mas e teste). NAO use sandbox.mercadopago — gera loop de redirect.
# MERCADOPAGO_SANDBOX so afeta tokens classicos TEST-...
MERCADOPAGO_SANDBOX=0
PRO_PRICE_BRL=99

# Dashboard admin (/admin?token=...)
ADMIN_DASHBOARD_TOKEN=troque-este-token
# Opcional: pasta persistente no Render Disk
# RADAR_DATA_DIR=/var/data/radar
